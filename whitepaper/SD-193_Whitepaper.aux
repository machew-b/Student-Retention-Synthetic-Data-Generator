\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces End-to-end synthetic cohort generation pipeline. The outer plate (student $i=1,\ldots  ,N$, $N=50{,}000$) and inner plate (term $t=1,\ldots  ,T_i$, $T_i \le 8$) show the two levels of repetition described in Section~\ref {sec:architecture}. Phases 1--4 and the per-term outcome draw (5a) repeat inside these plates; batch validation (5b) is drawn outside both plates because it is a cohort-level operation that runs once, after the full synthetic cohort exists, not a per-student or per-term step. The dashed arrow is the calibration feedback path, not a data-generation step.}}{6}{figure.1}\protected@file@percent }
\newlabel{fig:pipeline}{{1}{6}{End-to-end synthetic cohort generation pipeline. The outer plate (student $i=1,\ldots ,N$, $N=50{,}000$) and inner plate (term $t=1,\ldots ,T_i$, $T_i \le 8$) show the two levels of repetition described in Section~\ref {sec:architecture}. Phases 1--4 and the per-term outcome draw (5a) repeat inside these plates; batch validation (5b) is drawn outside both plates because it is a cohort-level operation that runs once, after the full synthetic cohort exists, not a per-student or per-term step. The dashed arrow is the calibration feedback path, not a data-generation step}{figure.1}{}}
